# ============================================================================
# XPENG Media Hub — variables d'environnement du serveur auto-hébergé
#
# Copiez ce fichier en `.env` à côté de docker-compose.yml, ou reportez ces
# valeurs dans la section `environment:` du compose.
# ============================================================================

# ----------------------------------------------------------------- Serveur --
PORT=8080
HOST=0.0.0.0
TZ=Europe/Paris

# ------------------------------------------------------------- Proxy IPTV ---
# true si votre serveur IPTV / playlist M3U est sur votre réseau local.
PROXY_ALLOW_PRIVATE=false
# Certains serveurs Xtream n'acceptent que le User-Agent d'un vrai lecteur.
PROXY_USER_AGENT=VLC/3.0.20 LibVLC/3.0.20

# --------------------------------------- Synchronisation + données véhicule --
# Jeton partageé par tous vos appareils. Il protège /api/sync ET /api/vehicle.
# Tant qu'il n'est pas défini, ces deux API restent DÉSACTIVÉES.
# Générez-en un solide :  openssl rand -base64 32
API_TOKEN=

# Dossier des données persistantes dans le conteneur (à monter en volume).
DATA_DIR=/app/data

# Synchroniser aussi la configuration IPTV — qui contient l'URL, l'identifiant
# et le MOT DE PASSE de votre abonnement, en clair dans le fichier de données.
# Laissez false sauf si vous savez pourquoi vous l'activez.
SYNC_ALLOW_SECRETS=false

# ---------------------------------------------------------------- Véhicule --
# off  : intégration désactivée (défaut)
# demo : état simulé, pour voir l'interface sans voiture ni compte
# xpeng: compte constructeur — nécessite les variables XPENG_* ci-dessous
VEHICLE_PROVIDER=off
VEHICLE_POLL_MS=60000

# ⚠️ XPENG ne publie aucune API publique : les endpoints ci-dessous ne sont pas
# fournis, vous devez les renseigner vous-même. Voir docs/VEHICULE.md.
# XPENG_API_BASE=
# XPENG_LOGIN_PATH=/auth/login
# XPENG_LOGIN_BODY={"account":"{{account}}","password":"{{password}}"}
# XPENG_TOKEN_FIELD=data.token
# XPENG_STATUS_PATH=/vehicle/status
# XPENG_AUTH_HEADER=Authorization: Bearer {{token}}
# XPENG_FIELD_MAP={"batteryPercent":"data.soc","rangeKm":"data.range"}
